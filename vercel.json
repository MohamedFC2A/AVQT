{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/portal/(.*)", "destination": "/portal/$1" },
    { "source": "/portal", "destination": "/portal/index.html" },
    { "source": "/ext/(.*)", "destination": "/ext/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
