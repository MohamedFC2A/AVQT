{
  "name": "avqr-attendance-system",
  "version": "1.0.0",
  "type": "module",
  "description": "ATT Vision QR Tool (AVQR) - Smart Neubrutalism University Attendance System by Matany Group x FUE",
  "author": "Matany Group & Mohamed Matany",
  "license": "MIT",
  "scripts": {
    "build": "npm --prefix server install && npm --prefix server run build",
    "server:install": "cd server && npm install",
    "client:install": "cd client && npm install",
    "install:all": "npm run server:install && npm run client:install",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "server:build": "cd server && npm run build",
    "client:build": "cd client && npm run build",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "keywords": [
    "avqr",
    "attendance",
    "neubrutalism",
    "upstore-one",
    "matany-group",
    "fue",
    "chrome-extension",
    "webauthn",
    "neon-tech",
    "dynamic-qr"
  ]
}
